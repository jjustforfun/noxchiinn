{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/nohchiin-mott-lesson.json",
  "title": "Тема для Нохчийн Мотт",
  "type": "object",
  "required": ["id", "title", "level", "items", "lessons"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "level": { "type": "integer", "minimum": 1 },
    "language": { "const": "ce" },
    "version": { "type": "integer", "minimum": 1 },
    "reviewStatus": { "enum": ["native-review-needed", "reviewed"] },
    "sourceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "lessons": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "duration": { "type": "integer", "minimum": 1 },
          "items": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "items": {
      "type": "array", "minItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "chechen", "russian", "transcription", "audio", "audioStatus", "image", "ageGroup"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "chechen": { "type": "string", "minLength": 1 },
          "lower": { "type": "string" },
          "russian": { "type": "string", "minLength": 1 },
          "transcription": { "type": "string" },
          "number": { "type": "integer", "minimum": 1, "maximum": 20 },
          "swatch": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "sourceId": { "type": "string" },
          "audio": { "type": "string", "pattern": "^/audio/[a-z0-9-]+\\.(mp3|ogg)$" },
          "audioStatus": { "enum": ["pending", "ready"] },
          "recording": {
            "type": "object",
            "required": ["reviewed", "permission"],
            "properties": {
              "reviewed": { "const": true },
              "permission": { "type": "string", "minLength": 3, "description": "Публичная лицензия или неперсональный код разрешения" },
              "speaker": { "type": "string", "description": "Согласованный псевдоним, не контактные данные" },
              "revision": { "type": "string", "description": "Версия записи для офлайн-кэша" }
            }
          },
          "image": { "type": ["string", "null"], "pattern": "^/images/[a-zA-Z0-9/_-]+\\.(svg|png|webp|avif|jpg)(#[a-zA-Z0-9_-]+)?$" },
          "ageGroup": { "enum": ["all", "5-8", "9+"] },
          "type": { "enum": ["vowel", "consonant", "special", "sign", "word"] }
        },
        "allOf": [{ "if": { "properties": { "audioStatus": { "const": "ready" } } }, "then": { "required": ["recording"] } }]
      }
    }
  }
}