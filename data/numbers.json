    { "id": "number-1", "chechen": "Цхьаъ", "russian": "Один", "transcription": "Цхьаъ: сочетание хь не равно мягкому русскому х; конечный ъ важен.", "number": 1, "type": "word", "audio": "/audio/number-1.mp3", "audioStatus": "pending", "image": null, "ageGroup": "all" },
