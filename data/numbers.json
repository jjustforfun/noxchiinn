    { "id": "number-7", "chechen": "ВорхӀ", "russian": "Семь", "transcription": "ВорхӀ: хӀ обозначает гортанный согласный, русского аналога нет.", "number": 7, "type": "word", "audio": "/audio/number-7.mp3", "audioStatus": "pending", "image": null, "ageGroup": "all" },
